<%- include('partials/head', { title: 'Review upgrade — PadSign Deployment Wizard' }) %>
<%- include('partials/topbar', { hostname, version, hasCompletedSetup, runActive }) %>
<%- include('partials/collapsed-progress', { sessionNote: 'Reviewing configuration changes before upgrading' }) %>
<main id="main" class="wizard-shell">
  <div class="card">
    <h1>Review this upgrade</h1>
    <p class="subtitle">
      Generated by <code>upgrade.sh --plan-only</code>, which evaluates the same guards the real run uses.
      Nothing has been changed yet.
    </p>

    <h3>Image tags</h3>
    <ul class="checklist">
      <% [['ps-server', plan.tags.server], ['ps-client', plan.tags.client]].forEach(([name, t]) => { %>
        <li>
          <span class="badge <%= t.changes ? 'badge-warn' : 'badge-pending' %>"><%= t.changes ? 'CHANGE' : 'SAME' %></span>
          <span><strong><%= name %></strong>:
            <% if (t.changes) { %><%= t.from %> → <%= t.to %><% } else { %><%= t.from || 'unknown' %> (unchanged)<% } %>
          </span>
        </li>
      <% }) %>
    </ul>

    <hr class="divider">
    <h3>Configuration changes</h3>

    <% if (plan.empty) { %>
      <div class="run-outcome run-outcome-success">
        <span>
          <strong>No configuration changes.</strong>
          <span class="run-outcome-detail">
            This upgrade will only pull images and restart containers. Your existing configuration —
            including any customised values — is left exactly as it is.
          </span>
        </span>
      </div>
      <% if (plan.items.length) { %>
        <p class="subtitle" style="margin-top:1rem;">
          <%= plan.items.length %> migration<%= plan.items.length === 1 ? '' : 's' %> checked, all already applied:
          <%= plan.items.map((i) => i.id).join(', ') %>.
        </p>
      <% } %>
    <% } else { %>
      <p class="subtitle">
        <%= plan.pendingCount %> of <%= plan.items.length %> migration<%= plan.items.length === 1 ? '' : 's' %>
        would change something. Each one only ever adds what is missing — a migration listed as
        <em>already applied</em> will not touch your customised values.
      </p>

      <% plan.items.forEach((item) => { const pending = item.status === 'will-apply'; %>
        <details class="plan-item" <%= pending ? 'open' : '' %>>
          <summary>
            <span class="badge <%= pending ? 'badge-warn' : 'badge-ok' %>"><%= pending ? 'WILL APPLY' : 'APPLIED' %></span>
            <span class="plan-item-title"><%= item.title %></span>
            <code class="plan-item-id"><%= item.id %></code>
          </summary>
          <p class="hint plan-item-files">Files: <%= item.files.join(', ') %></p>
          <% if (pending && item.body) { %>
            <pre class="plan-body"><%= item.body %></pre>
          <% } else { %>
            <p class="hint">Already present in this deployment — nothing would be written.</p>
          <% } %>
        </details>
      <% }) %>
    <% } %>

    <hr class="divider">
    <button id="applyBtn" type="button" class="btn btn-primary">
      <%= plan.empty ? 'Pull images and restart' : 'Apply and upgrade' %>
    </button>
    <a href="/dashboard" class="btn btn-link">Cancel</a>
    <p id="applyError" class="error-text" role="alert" style="margin-top:1rem;"></p>
  </div>
</main>
<script>
  document.getElementById('applyBtn').addEventListener('click', async function () {
    const errBox = document.getElementById('applyError');
    errBox.textContent = '';
    this.disabled = true;
    const original = this.textContent;
    this.textContent = 'Starting…';
    try {
      const resp = await fetch('/api/upgrade/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ previewId: <%- JSON.stringify(previewId) %> })
      });
      const data = await resp.json();
      if (!resp.ok) {
        errBox.textContent = data.error || 'Failed to start the upgrade.';
        this.disabled = false;
        this.textContent = original;
        return;
      }
      window.location.href = '/upgrade/progress?runId=' + encodeURIComponent(data.runId);
    } catch (e) {
      errBox.textContent = 'Request failed — check your connection to the wizard.';
      this.disabled = false;
      this.textContent = original;
    }
  });
</script>
<%- include('partials/foot') %>
