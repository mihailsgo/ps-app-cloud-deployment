<%- include('partials/head', { title: 'Welcome — PadSign Deployment Wizard', bodyClass: 'is-onboarding is-welcome' }) %>
<%
  // Full-viewport navy page: no rail, no top bar, no action bar. Log Out
  // lives in the footer and opens the same logout modal the top bar uses.
  const STEP_OVERVIEW = ['Host & Company', 'TLS Certificate', 'Feature Toggles', 'Review & Confirm', 'Deploy', 'Verify & Go-Live'];
-%>
<main id="main" class="welcome">
  <img class="welcome__fingerprint" src="/fingerprint.png" alt="">
  <div class="welcome__panel">
    <img class="welcome__logo" src="/logo-white.png" alt="TrustLynx" width="148" height="44">

    <div class="welcome__body">
      <%- include('partials/overlay-banner') %>
      <% if (saved) { %>
        <div class="welcome__head">
          <span class="eyebrow eyebrow-light">Welcome back</span>
          <h1 class="welcome__title">Welcome back</h1>
          <p class="welcome__lead">You have setup in progress. Pick up where you left off, or start fresh.</p>
        </div>

        <div class="resume-card">
          <span class="resume-label">RESUME AT</span>
          <span class="resume-step-name"><%= savedStepLabel %></span>
        </div>

        <div class="welcome__actions">
          <a href="/api/wizard/resume" class="btn btn-primary btn-lg">Resume Setup</a>
          <form method="post" action="/api/wizard/start-over">
            <button type="submit" class="btn btn-secondary btn-lg">Start Over</button>
          </form>
        </div>
      <% } else { %>
        <div class="welcome__head">
          <span class="eyebrow eyebrow-light">Step 1 · Welcome</span>
          <h1 class="welcome__title">Deploy PadSign in your controlled environment</h1>
          <p class="welcome__lead">Environment check before we get started. After that, six steps configure PadSign on this server, and you can save and come back at any point.</p>
        </div>

        <section class="env-check" aria-labelledby="env-title">
          <h2 class="env-check__title" id="env-title">Environment check</h2>
          <ul class="checklist">
            <li>
              <span class="badge <%= dockerOk ? 'badge-ok' : 'badge-fail' %>"><%= dockerOk ? 'OK' : 'FAIL' %></span>
              <span>Docker daemon reachable from the wizard container</span>
            </li>
            <li>
              <span class="badge badge-ok">OK</span>
              <span>Project directory: <code><%= projectDir %></code></span>
            </li>
          </ul>
          <div class="env-check__state">
            <p>Detected deployment state</p>
            <span class="state-pill"><%= state.state %></span>
            <p>
              <% if (state.state === 'FRESH') { %>
                No previous bootstrap detected in this checkout, ready for a first-time install.
              <% } else { %>
                This checkout has already been bootstrapped, but the stack isn't currently running.
              <% } %>
            </p>
          </div>
        </section>

        <ol class="step-overview" aria-label="Setup steps">
          <% STEP_OVERVIEW.forEach((label, i) => { %>
            <li><span aria-hidden="true">0<%= i + 2 %></span><span><%= label %></span></li>
          <% }) %>
        </ol>

        <div class="welcome__actions">
          <a href="/wizard/step/2" class="btn btn-primary btn-lg">Begin Setup</a>
        </div>
      <% } %>
    </div>

    <footer class="welcome__foot">
      <span class="welcome__meta"><span title="Configured hostname"><%= hostname %></span><% if (version) { %> · <span title="Installed ps-server / ps-client tags">v<%= version %></span><% } %></span>
      <button type="button" class="btn btn-text btn-sm<%= runActive ? ' is-disabled' : '' %>"<%- runActive ? ' aria-disabled="true"' : '' %>
        onclick="openModal('logout-modal')">Log Out</button>
    </footer>
  </div>
</main>
<%- include('partials/modal', {
  id: 'logout',
  title: 'End this session?',
  body: "You'll need your deployment token to sign back in.",
  cancelLabel: 'Cancel',
  confirmLabel: 'Log Out',
  confirmAction: '/api/logout'
}) %>
<%- include('partials/foot') %>
