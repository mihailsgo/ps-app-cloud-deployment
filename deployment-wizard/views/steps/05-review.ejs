<%- include('../partials/head', { title: 'Review — PadSign Deployment Wizard', bodyClass: 'is-onboarding' }) %>
<%- include('../partials/wizard-layout-start', { current: 5, furthestStepReached: wizard.furthestStepReached, hostname, version, hasCompletedSetup, runActive }) %>
  <div class="form-col form-col--wide">
    <div class="page-head">
      <span class="eyebrow">Step 5 · Review &amp; Confirm</span>
      <h1 class="page-title">Review &amp; Confirm</h1>
      <p class="page-lead">Everything below is what a direct <code>bootstrap.sh</code> run would be given, in the same shape.</p>
    </div>

    <%- include('../partials/overlay-banner') %>
    <p id="deployError" class="error-text" role="alert"></p>

    <section class="card" aria-labelledby="sec-host">
      <%- include('../partials/card-head', { id: 'sec-host', icon: 'globe', title: 'Host & Company', edit: { href: '/wizard/step/2', label: 'Edit Host & Company' } }) %>
      <dl class="review-list">
        <div class="review-row"><dt>Host</dt><dd><%= wizard.host %></dd></div>
        <div class="review-row"><dt>Company / role</dt><dd><%= wizard.companyRole %></dd></div>
        <div class="review-row"><dt>Keycloak realm</dt><dd><%= wizard.realm %></dd></div>
        <div class="review-row">
          <dt>Keycloak admin</dt>
          <dd><%= wizard.adminUser %> / <span id="pw-mask">••••••••</span><button type="button" id="pw-toggle" class="btn btn-text btn-sm" aria-label="Show the Keycloak admin password" aria-pressed="false">show</button></dd>
        </div>
      </dl>
    </section>

    <section class="card" aria-labelledby="sec-tls">
      <%- include('../partials/card-head', { id: 'sec-tls', icon: 'lock', title: 'TLS certificate', edit: { href: '/wizard/step/3', label: 'Edit TLS certificate' } }) %>
      <ul class="checklist">
        <li><span class="badge badge-ok">OK</span><span>TLS certificate validated for <strong><%= wizard.cert.host %></strong><% if (wizard.allowSelfSigned) { %> (chain check skipped — self-signed allowed)<% } %></span></li>
      </ul>
    </section>

    <section class="card" aria-labelledby="sec-review-features">
      <%- include('../partials/card-head', { id: 'sec-review-features', icon: 'toggle-right', title: 'Features', edit: { href: '/wizard/step/4', label: 'Edit Features' } }) %>
      <ul class="checklist">
        <% features.forEach((f) => { %>
          <li>
            <span class="badge <%= wizard.features[f.key] ? 'badge-ok' : 'badge-pending' %>"><%= wizard.features[f.key] ? 'ON' : 'OFF' %></span>
            <span><%= f.label %></span>
          </li>
        <% }) %>
      </ul>
    </section>

    <section class="card" aria-labelledby="sec-command">
      <%- include('../partials/card-head', { id: 'sec-command', icon: 'clipboard-check', title: 'Equivalent command' }) %>
      <p class="review-note">Deploying runs the same steps as</p>
      <pre class="cmd"><code>KEYCLOAK_ADMIN_PASSWORD=**** bootstrap.sh --host <%= wizard.host %> --company-role "<%= wizard.companyRole %>"<% features.forEach((f) => { if (wizard.features[f.key]) { %> --<%= f.key.replace(/_/g, '-') %><% } }) %><% if (wizard.allowSelfSigned) { %> --allow-self-signed<% } %></code></pre>
    </section>
  </div>
<%# Deploy is refused server-side on an overlay-managed checkout (lib/overlayGuard.js). %>
<%- include('../partials/wizard-layout-end', { actionbar: {
  back: { href: '/wizard/step/4', label: 'Back' },
  next: { kind: 'button', id: 'deployBtn', label: 'Confirm & Deploy', disabled: typeof overlay !== 'undefined' && Boolean(overlay) }
} }) %>
<script>
  document.getElementById('deployBtn').addEventListener('click', async function () {
    this.disabled = true;
    this.textContent = 'Starting…';
    const errBox = document.getElementById('deployError');
    errBox.textContent = '';
    try {
      const resp = await fetch('/api/deploy', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'bootstrap' })
      });
      const data = await resp.json();
      if (!resp.ok) {
        errBox.textContent = data.error || 'Failed to start deploy.';
        this.disabled = false;
        this.textContent = 'Confirm & Deploy';
        return;
      }
      window.location.href = '/wizard/step/6?runId=' + encodeURIComponent(data.runId);
    } catch (e) {
      errBox.textContent = 'Request failed — check your connection to the wizard.';
      this.disabled = false;
      this.textContent = 'Confirm & Deploy';
    }
  });

  document.getElementById('pw-toggle').addEventListener('click', function () {
    const mask = document.getElementById('pw-mask');
    if (mask.textContent.includes('•')) {
      mask.textContent = <%- JSON.stringify(wizard.adminPass || '') %>;
      this.textContent = 'hide';
      this.setAttribute('aria-label', 'Hide the Keycloak admin password');
      this.setAttribute('aria-pressed', 'true');
    } else {
      mask.textContent = '••••••••';
      this.textContent = 'show';
      this.setAttribute('aria-label', 'Show the Keycloak admin password');
      this.setAttribute('aria-pressed', 'false');
    }
  });
</script>
<%- include('../partials/foot') %>
