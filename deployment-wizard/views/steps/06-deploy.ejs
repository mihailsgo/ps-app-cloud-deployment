<%- include('../partials/head', { title: 'Deploy — PadSign Deployment Wizard', bodyClass: 'is-onboarding' }) %>
<%- include('../partials/wizard-layout-start', { current: 6, furthestStepReached: wizard.furthestStepReached, hostname, version, hasCompletedSetup, runActive }) %>
  <div class="form-col form-col--wide">
    <div class="page-head">
      <span class="eyebrow">Step 6 · Deploy</span>
      <h1 class="page-title">Deploying</h1>
      <p class="page-lead">Running the same steps as a direct <code>bootstrap.sh</code> invocation.</p>
    </div>

    <section class="card" aria-labelledby="sec-deploy">
      <%- include('../partials/card-head', { id: 'sec-deploy', icon: 'server', title: 'Deployment' }) %>

      <ul class="checklist" id="deploySteps" aria-live="polite" aria-relevant="additions text"
          aria-label="Deployment steps"></ul>

      <p id="overallStatus" class="status-line" role="status"></p>

      <div id="runActions" class="run-actions" hidden></div>

      <details class="raw-output">
        <summary>Raw output</summary>
        <pre id="rawLog" class="log" tabindex="0"></pre>
      </details>
    </section>
  </div>
<%
  // continueLink is rendered without an href while disabled: relying on
  // pointer-events:none stops the mouse but not the keyboard, and Tab +
  // Enter walked straight past the gate into step 7 mid-deploy. No Back
  // while running; run-progress.js adds its own Back on failure.
%>
<%- include('../partials/wizard-layout-end', { actionbar: {
  hint: { id: 'continueHint', text: 'Available once the deploy finishes successfully.' },
  next: { kind: 'link', id: 'continueLink', label: 'Continue to Verify', disabled: true }
} }) %>
<script src="/run-progress.js"></script>
<script>
  initRunProgress({
    runId: <%- JSON.stringify(runId) %>,
    successText: 'Bootstrap finished successfully.',
    failText: 'Bootstrap failed.',
    backHref: '/wizard/step/5',
    backLabel: 'Back to Review',
    retryRedirect: '/wizard/step/6',
    // bootstrap.sh goes quiet here while it waits on Keycloak; without this
    // the UI looks hung.
    stepHints: { '5': 'Keycloak setup — this can take up to a minute, output pauses here' },
    onSuccess: function () {
      var link = document.getElementById('continueLink');
      link.href = '/wizard/step/7';
      link.classList.remove('is-disabled');
      link.removeAttribute('aria-disabled');
      link.focus();
      document.getElementById('continueHint').remove();
    }
  });
</script>
<%- include('../partials/foot') %>
