<%- include('../partials/head', { title: 'Verify — PadSign Deployment Wizard', bodyClass: 'is-onboarding' }) %>
<%- include('../partials/wizard-layout-start', { current: 7, furthestStepReached: wizard.furthestStepReached, hostname, version, hasCompletedSetup, runActive }) %>
  <div class="form-col form-col--wide">
    <div class="page-head">
      <span class="eyebrow">Step 7 · Verify &amp; Go-Live</span>
      <h1 class="page-title">Verify &amp; Go-Live Checklist</h1>
      <p class="page-lead">
        Same checks as <code>validate-config.sh</code>. Failures are shown but won't block you from
        continuing — fix them at your own pace, they'll keep showing up here until resolved.
      </p>
    </div>

    <section class="card" aria-labelledby="sec-checks">
      <%- include('../partials/card-head', { id: 'sec-checks', icon: 'badge-check', title: 'Configuration checks' }) %>
      <p id="verifyStatus" class="status-line" role="status">Running checks…</p>
      <div id="resultBox" class="result-box" aria-live="polite"></div>
    </section>

    <section class="card" aria-labelledby="sec-before-prod">
      <%- include('../partials/card-head', { id: 'sec-before-prod', icon: 'clipboard-check', title: 'Before production' }) %>
      <ul class="checklist">
        <li>
          <span class="badge badge-warn">TODO</span>
          <span>Delete the demo <code>test</code> Keycloak user before production use.</span>
        </li>
      </ul>
    </section>
  </div>
<%- include('../partials/wizard-layout-end', { actionbar: {
  back: { href: '/wizard/step/6?runId=' + (wizard.lastRunId || ''), label: 'Back to deploy log' },
  next: { kind: 'link', href: '/dashboard', label: 'Continue to Dashboard' }
} }) %>
<script>
  const badgeClass = { ok: 'badge-ok', fail: 'badge-fail', warn: 'badge-warn' };
  // escapeHtml comes from /wizard-ui.js.
  (async () => {
    const status = document.getElementById('verifyStatus');
    const box = document.getElementById('resultBox');
    try {
      const resp = await fetch('/api/wizard/verify');
      const data = await resp.json();
      if (!resp.ok) {
        status.textContent = '';
        box.innerHTML = '<p class="error-text">' + escapeHtml(data.error || 'Verification failed to run.') + '</p>';
        return;
      }
      status.textContent = data.passed ? 'All checks passed.' : 'Some checks failed — see below.';
      box.innerHTML = '<ul class="checklist">' + data.checks.map((c) =>
        '<li><span class="badge ' + (badgeClass[c.status] || 'badge-pending') + '">' + c.status.toUpperCase() + '</span><span>' + escapeHtml(c.message).replace(/\n/g, '<br>') + '</span></li>'
      ).join('') + '</ul>';
    } catch (e) {
      status.textContent = '';
      box.innerHTML = '<p class="error-text">Request failed — check your connection to the wizard.</p>';
    }
  })();
</script>
<%- include('../partials/foot') %>
