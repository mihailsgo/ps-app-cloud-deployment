<%- include('../partials/head', { title: 'TLS Certificate — PadSign Deployment Wizard', bodyClass: 'is-onboarding' }) %>
<%- include('../partials/wizard-layout-start', { current: 3, furthestStepReached: wizard.furthestStepReached, hostname, version, hasCompletedSetup, runActive }) %>
  <div class="form-col">
    <div class="page-head">
      <span class="eyebrow">Step 3 · TLS Certificate</span>
      <h1 class="page-title">TLS Certificate</h1>
      <p class="page-lead">
        For <strong><%= wizard.host %></strong>. Provide a fullchain certificate (leaf + intermediates) and its
        matching private key — either as files or pasted text. Validated the same way
        <code>validate-certs.sh</code> already checks it before any container starts.
      </p>
    </div>

    <section class="card" aria-labelledby="sec-cert">
      <%- include('../partials/card-head', { id: 'sec-cert', icon: 'lock', title: 'Certificate' }) %>
      <div class="field">
        <label for="crtFile">Certificate file (.crt / fullchain.pem)</label>
        <input type="file" id="crtFile" accept=".crt,.pem,.cer" aria-describedby="crtFile-hint">
        <p class="hint" id="crtFile-hint">Or paste PEM text below instead.</p>
        <textarea id="crtText" rows="4" aria-label="Certificate, pasted as PEM text" placeholder="-----BEGIN CERTIFICATE-----"></textarea>
      </div>
    </section>

    <section class="card" aria-labelledby="sec-key">
      <%- include('../partials/card-head', { id: 'sec-key', icon: 'lock', title: 'Private key' }) %>
      <div class="field">
        <label for="keyFile">Private key file (.key)</label>
        <input type="file" id="keyFile" accept=".key,.pem" aria-describedby="keyFile-hint">
        <p class="hint" id="keyFile-hint">Or paste PEM text below instead. Never stored beyond this validation step.</p>
        <textarea id="keyText" rows="4" aria-label="Private key, pasted as PEM text" placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
      </div>
    </section>

    <section class="card" aria-labelledby="sec-validate">
      <%- include('../partials/card-head', { id: 'sec-validate', icon: 'shield-check', title: 'Validation' }) %>
      <label class="check-label">
        <input type="checkbox" id="allowSelfSigned">
        Allow self-signed / skip chain verification (development only)
      </label>

      <div class="inline-status">
        <button id="validateBtn" type="button" class="btn btn-secondary">Validate certificate</button>
        <span id="validateStatus" class="subtitle" role="status"></span>
      </div>

      <div id="resultBox" class="result-box" aria-live="polite"></div>
    </section>
  </div>

  <%- include('../partials/summary', {
    rows: [
      { id: 'sum-url', label: 'Public URL', value: wizard.host ? 'https://' + wizard.host : '', fallback: 'Not set yet' },
      { id: 'sum-role', label: 'Realm role', value: wizard.companyRole || '', fallback: 'Not set yet' },
      { id: 'sum-cert', label: 'Certificate', value: '', fallback: 'Not validated yet' }
    ],
    next: { n: 4, label: 'Feature Toggles' }
  }) %>
<%
  // nextLink is rendered with no href until validation passes:
  // pointer-events:none alone stopped the mouse but not Tab + Enter.
%>
<%- include('../partials/wizard-layout-end', { actionbar: {
  back: { href: '/wizard/step/2', label: 'Back' },
  hint: { id: 'nextHint', text: 'Validate a certificate to continue.' },
  next: { kind: 'link', id: 'nextLink', label: 'Next: Feature Toggles', disabled: true }
} }) %>
<script>
  const badgeClass = { ok: 'badge-ok', fail: 'badge-fail', warn: 'badge-warn' };

  function renderChecklist(checks) {
    const items = checks.map((c) => `
      <li>
        <span class="badge ${badgeClass[c.status] || 'badge-pending'}">${c.status.toUpperCase()}</span>
        <span>${escapeHtml(c.message).replace(/\n/g, '<br>')}</span>
      </li>`).join('');
    return `<ul class="checklist">${items}</ul>`;
  }

  // escapeHtml comes from /wizard-ui.js.

  function setCertSummary(validated) {
    const el = document.getElementById('sum-cert');
    el.textContent = validated ? 'Validated' : 'Not validated yet';
    el.classList.toggle('is-empty', !validated);
  }

  function lockNext() {
    const nextLink = document.getElementById('nextLink');
    nextLink.removeAttribute('href');
    nextLink.classList.add('is-disabled');
    nextLink.setAttribute('aria-disabled', 'true');
    setCertSummary(false);
  }

  function unlockNext() {
    const nextLink = document.getElementById('nextLink');
    nextLink.href = '/wizard/step/4';
    nextLink.classList.remove('is-disabled');
    nextLink.removeAttribute('aria-disabled');
    const hint = document.getElementById('nextHint');
    if (hint) hint.remove();
    setCertSummary(true);
    nextLink.focus();
  }

  document.getElementById('validateBtn').addEventListener('click', async () => {
    const status = document.getElementById('validateStatus');
    const resultBox = document.getElementById('resultBox');
    status.textContent = 'Validating…';
    lockNext();

    const crtFile = document.getElementById('crtFile').files[0];
    const keyFile = document.getElementById('keyFile').files[0];
    const crtText = document.getElementById('crtText').value.trim();
    const keyText = document.getElementById('keyText').value.trim();
    const allowSelfSigned = document.getElementById('allowSelfSigned').checked;

    const form = new FormData();
    if (crtFile) form.append('crtFile', crtFile); else form.append('crtText', crtText);
    if (keyFile) form.append('keyFile', keyFile); else form.append('keyText', keyText);
    form.append('allowSelfSigned', allowSelfSigned ? 'on' : 'off');

    try {
      const resp = await fetch('/api/wizard/cert-upload', { method: 'POST', body: form });
      const data = await resp.json();
      if (!resp.ok) {
        status.textContent = '';
        resultBox.innerHTML = `<p class="error-text">${escapeHtml(data.error || 'Validation failed to run.')}</p>`;
        return;
      }
      status.textContent = data.passed ? 'All checks passed.' : 'Some checks failed.';
      resultBox.innerHTML = renderChecklist(data.checks);
      if (data.passed) unlockNext();
    } catch (e) {
      status.textContent = '';
      resultBox.innerHTML = '<p class="error-text">Request failed — check your connection to the wizard.</p>';
    }
  });
</script>
<%- include('../partials/foot') %>
