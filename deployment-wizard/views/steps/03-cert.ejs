<%- include('../partials/head', { title: 'TLS Certificate — PadSign Deployment Wizard' }) %>
<%- include('../partials/topbar', { hostname, version, hasCompletedSetup, runActive }) %>
<main id="main" class="wizard-shell">
  <%- include('../partials/stepProgress', { current: 3, furthestStepReached: wizard.furthestStepReached }) %>

  <div class="card">
    <h1>TLS Certificate</h1>
    <p class="subtitle">
      For <strong><%= wizard.host %></strong>. Provide a fullchain certificate (leaf + intermediates) and its
      matching private key — either as files or pasted text. Validated the same way
      <code>validate-certs.sh</code> already checks it before any container starts.
    </p>

    <div class="field">
      <label for="crtFile">Certificate file (.crt / fullchain.pem)</label>
      <input type="file" id="crtFile" accept=".crt,.pem,.cer">
      <p class="hint">Or paste PEM text below instead.</p>
      <textarea id="crtText" rows="4" style="width:100%; font-family:monospace; font-size:0.8rem;" placeholder="-----BEGIN CERTIFICATE-----"></textarea>
    </div>

    <div class="field">
      <label for="keyFile">Private key file (.key)</label>
      <input type="file" id="keyFile" accept=".key,.pem">
      <p class="hint">Or paste PEM text below instead. Never stored beyond this validation step.</p>
      <textarea id="keyText" rows="4" style="width:100%; font-family:monospace; font-size:0.8rem;" placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
    </div>

    <div class="field">
      <label style="display:flex; align-items:center; gap:0.5rem; font-weight:400;">
        <input type="checkbox" id="allowSelfSigned" style="width:auto;">
        Allow self-signed / skip chain verification (development only)
      </label>
    </div>

    <button id="validateBtn" type="button" class="btn btn-secondary">Validate certificate</button>
    <span id="validateStatus" class="subtitle" role="status" style="margin:0 0 0 0.75rem;"></span>

    <div id="resultBox" style="margin-top:1.25rem;" aria-live="polite"></div>

    <hr class="divider">
    <%
      // No href until validation passes — pointer-events:none alone stopped
      // the mouse but not Tab + Enter.
    %>
    <a id="nextLink" class="btn btn-primary is-disabled" aria-disabled="true">Next: Feature Toggles</a>
    <span id="nextHint" class="hint" style="display:inline-block; margin-left:0.5rem;">Validate a certificate to continue.</span>
    <a href="/wizard/step/2" class="btn btn-link">Back</a>
  </div>
</main>
<script>
  const badgeClass = { ok: 'badge-ok', fail: 'badge-fail', warn: 'badge-warn' };

  function renderChecklist(checks) {
    const items = checks.map((c) => `
      <li>
        <span class="badge ${badgeClass[c.status] || 'badge-pending'}">${c.status.toUpperCase()}</span>
        <span>${escapeHtml(c.message).replace(/\n/g, '<br>')}</span>
      </li>`).join('');
    return `<ul class="checklist">${items}</ul>`;
  }

  // escapeHtml comes from /wizard-ui.js.

  function lockNext() {
    const nextLink = document.getElementById('nextLink');
    nextLink.removeAttribute('href');
    nextLink.classList.add('is-disabled');
    nextLink.setAttribute('aria-disabled', 'true');
  }

  function unlockNext() {
    const nextLink = document.getElementById('nextLink');
    nextLink.href = '/wizard/step/4';
    nextLink.classList.remove('is-disabled');
    nextLink.removeAttribute('aria-disabled');
    const hint = document.getElementById('nextHint');
    if (hint) hint.remove();
    nextLink.focus();
  }

  document.getElementById('validateBtn').addEventListener('click', async () => {
    const status = document.getElementById('validateStatus');
    const resultBox = document.getElementById('resultBox');
    status.textContent = 'Validating…';
    lockNext();

    const crtFile = document.getElementById('crtFile').files[0];
    const keyFile = document.getElementById('keyFile').files[0];
    const crtText = document.getElementById('crtText').value.trim();
    const keyText = document.getElementById('keyText').value.trim();
    const allowSelfSigned = document.getElementById('allowSelfSigned').checked;

    const form = new FormData();
    if (crtFile) form.append('crtFile', crtFile); else form.append('crtText', crtText);
    if (keyFile) form.append('keyFile', keyFile); else form.append('keyText', keyText);
    form.append('allowSelfSigned', allowSelfSigned ? 'on' : 'off');

    try {
      const resp = await fetch('/api/wizard/cert-upload', { method: 'POST', body: form });
      const data = await resp.json();
      if (!resp.ok) {
        status.textContent = '';
        resultBox.innerHTML = `<p class="error-text">${escapeHtml(data.error || 'Validation failed to run.')}</p>`;
        return;
      }
      status.textContent = data.passed ? 'All checks passed.' : 'Some checks failed.';
      resultBox.innerHTML = renderChecklist(data.checks);
      if (data.passed) unlockNext();
    } catch (e) {
      status.textContent = '';
      resultBox.innerHTML = '<p class="error-text">Request failed — check your connection to the wizard.</p>';
    }
  });
</script>
<%- include('../partials/foot') %>
