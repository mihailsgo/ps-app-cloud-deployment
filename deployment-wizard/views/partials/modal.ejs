<%
  // Shared confirm-modal markup. Expects: id, title, body, cancelLabel,
  // confirmLabel, confirmAction (form POST target); optional confirmClass
  // (defaults to btn-primary). Hidden by default; opened via
  // openModal('<id>-modal') from public/wizard-ui.js, which owns the focus
  // trap, Escape handling, overlay-click dismiss and focus restoration (see
  // topbar.ejs / welcome.ejs triggers).
  const confirmBtnClass = typeof confirmClass !== 'undefined' && confirmClass ? confirmClass : 'btn-primary';
%>
<div class="modal-overlay" id="<%= id %>-modal">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="<%= id %>-modal-title">
    <h2 id="<%= id %>-modal-title"><%= title %></h2>
    <p><%= body %></p>
    <div class="modal-actions">
      <button type="button" class="btn btn-secondary" onclick="closeModal('<%= id %>-modal')"><%= cancelLabel %></button>
      <form method="post" action="<%= confirmAction %>">
        <button type="submit" class="btn <%= confirmBtnClass %>"><%= confirmLabel %></button>
      </form>
    </div>
  </div>
</div>
