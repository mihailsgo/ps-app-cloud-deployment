<%
  // Optional: title, bodyClass (onboarding pages pass 'is-onboarding', which
  // switches btn-primary to the gold accent; Welcome adds 'is-welcome').
  const pageBodyClass = typeof bodyClass !== 'undefined' && bodyClass ? bodyClass : '';
-%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'PadSign Deployment Wizard' %></title>
  <meta name="color-scheme" content="light">
  <link rel="icon" href="/logo.png">
  <link rel="stylesheet" href="/styles.css">
  <script src="/wizard-ui.js"></script>
</head>
<body<% if (pageBodyClass) { %> class="<%= pageBodyClass %>"<% } %>>
<a href="#main" class="skip-link">Skip to main content</a>
